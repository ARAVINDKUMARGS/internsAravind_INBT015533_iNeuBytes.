{
  "version": 2,
  "builds": [
    {
      "src": "healthcare-management-system/backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "healthcare-management-system/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "healthcare-management-system/backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "healthcare-management-system/frontend/$1"
    }
  ]
}
