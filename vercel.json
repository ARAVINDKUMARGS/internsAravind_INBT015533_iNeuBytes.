{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "internsAravind_INBT015533_iNeuBytes-main/**"
        ]
      }
    },
    {
      "src": "internsAravind_INBT015533_iNeuBytes-main/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    },
    {
      "src": "/css/(.*)",
      "dest": "internsAravind_INBT015533_iNeuBytes-main/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "internsAravind_INBT015533_iNeuBytes-main/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "internsAravind_INBT015533_iNeuBytes-main/$1"
    }
  ]
}
